<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Generate Short URL</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }

    h1 {
      text-align: center;
    }

    .form-group {
      margin-bottom: 15px;
    }

    input[type="text"] {
      width: 300px;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    button {
      padding: 10px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }

    button:hover {
      background-color: #0056b3;
    }

    div {
      margin-top: 20px;
      text-align: center;
    }

    table {
      width: 60%;
      margin-top: 20px;
      border-collapse: collapse;
    }

    table, th, td {
      border: 1px solid #ccc;
    }

    th, td {
      padding: 8px;
      text-align: left;
    }

    th {
      background-color: #f2f2f2;
    }
  </style>
</head>

<body>
  <h1>Generate Short URL</h1>

  <form action="/url/create" method="POST">
    <div class="form-group">
      <input type="text" name="url" placeholder="Enter your URL here">
      <button type="submit">Submit</button>
    </div>
  </form>

  <div>
    <% if(!locals.status) { %>
    <p><%= locals.message %></p>
    <% } else { %>
    <p><%= locals.message %> : <%= locals.url %></p>
    <% } %>

    <% if(locals.urls && locals.urls.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Short URL</th>
          <th>Count</th>
        </tr>
      </thead>
      <tbody>
        <% locals.urls.forEach(function(item) { %>
        <tr>
          <td><%= item.shortUrl %></td>
          <td><%= item.count %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% }%>
  </div>

</body>

</html>
